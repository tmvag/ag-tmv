
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Official website of Triveni Secondary School, Department of Agriculture." />
  <title>Triveni Secondary School | Agriculture</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 80px;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      line-height: 1.6;
      color: #24332b;
      background: #f7faf7;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    header {
      background: #075c36;
      color: white;
      position: sticky;
      top: 0;
      z-index: 1000;
    }

    .navbar {
      max-width: 1200px;
      margin: auto;
      padding: 14px 5%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .brand {
      font-size: 19px;
      font-weight: bold;
    }

    .brand span {
      display: block;
      font-size: 12px;
      color: #d0efce;
      font-weight: normal;
    }

    .nav-links {
      display: flex;
      gap: 20px;
      list-style: none;
      flex-wrap: wrap;
    }

    .nav-links a:hover {
      color: #b9f59e;
    }

    .notice-bar {
      background: #ffdb55;
      color: #26331e;
      padding: 9px 0;
      display: flex;
      overflow: hidden;
      white-space: nowrap;
      gap: 12px;
      align-items: center;
    }

    .notice-label {
      background: #c52d22;
      color: white;
      padding: 3px 12px;
      font-weight: bold;
      z-index: 1;
    }

    .ticker {
      overflow: hidden;
      flex: 1;
    }

    .ticker a {
      display: inline-block;
      font-weight: bold;
      animation: ticker 22s linear infinite;
    }

    .ticker a:hover {
      animation-play-state: paused;
    }

    @keyframes ticker {
      from { transform: translateX(100%); }
      to { transform: translateX(-100%); }
    }

    .hero {
      min-height: 440px;
      position: relative;
      display: flex;
      align-items: center;
      color: white;
      background: #285b3d;
      overflow: hidden;
    }

    .slide {
      position: absolute;
      inset: 0;
      opacity: 0;
      background-size: cover;
      background-position: center;
      transition: opacity 1s ease;
    }

    .slide.active {
      opacity: 1;
    }

    .hero::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg,
        rgba(0, 35, 17, .85),
        rgba(0, 30, 15, .25));
      z-index: 1;
    }

    .hero-content {
      width: 100%;
      max-width: 1200px;
      margin: auto;
      padding: 70px 6%;
      position: relative;
      z-index: 2;
    }

    .hero-content h1 {
      font-size: clamp(32px, 5vw, 55px);
      line-height: 1.15;
      max-width: 750px;
      margin-bottom: 18px;
    }

    .hero-content p {
      font-size: 18px;
      max-width: 620px;
      margin-bottom: 28px;
    }

    .btn {
      display: inline-block;
      background: #f4d44d;
      color: #173d25;
      padding: 12px 23px;
      border-radius: 5px;
      font-weight: bold;
    }

    .btn:hover {
      background: white;
    }

    .section {
      padding: 65px 6%;
      max-width: 1200px;
      margin: auto;
    }

    .section-title {
      text-align: center;
      color: #075c36;
      font-size: 31px;
      margin-bottom: 12px;
    }

    .section-intro {
      text-align: center;
      max-width: 700px;
      margin: 0 auto 35px;
      color: #65736a;
    }

    .profiles {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 25px;
    }

    .profile-card {
      background: white;
      padding: 28px;
      border-radius: 12px;
      box-shadow: 0 4px 18px #163b2010;
      text-align: center;
      border-bottom: 4px solid #16824b;
    }

    .profile-card img {
      width: 130px;
      height: 130px;
      border-radius: 50%;
      object-fit: cover;
      margin-bottom: 16px;
      background: #e3eee4;
    }

    .profile-card h3 {
      color: #075c36;
      margin-bottom: 5px;
    }

    .profile-card .role {
      color: #bd8c17;
      font-weight: bold;
      margin-bottom: 12px;
    }

    .stats {
      background: #075c36;
      color: white;
      padding: 48px 6%;
    }

    .stats-grid {
      max-width: 1100px;
      margin: auto;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
      text-align: center;
    }

    .stat-number {
      font-size: 42px;
      font-weight: bold;
      color: #ffdf59;
    }

    .stat-label {
      font-size: 16px;
    }

    .testimonials {
      overflow: hidden;
      width: 100%;
    }

    .testimonial-track {
      display: flex;
      width: max-content;
      gap: 20px;
      animation: testimonial-scroll 35s linear infinite;
    }

    .testimonial-track:hover {
      animation-play-state: paused;
    }

    .testimonial {
      background: white;
      width: 300px;
      padding: 24px;
      border-radius: 10px;
      border-left: 4px solid #16824b;
      box-shadow: 0 4px 18px #163b2010;
    }

    .testimonial p {
      font-style: italic;
      margin-bottom: 12px;
    }

    .testimonial h4 {
      color: #075c36;
    }

    @keyframes testimonial-scroll {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }

    .contact {
      background: #e9f3e9;
      padding: 55px 6%;
      text-align: center;
    }

    .contact h2 {
      color: #075c36;
      margin-bottom: 15px;
    }

    footer {
      background: #103b27;
      color: #e8f1e9;
      padding: 42px 6% 18px;
    }

    .footer-grid {
      max-width: 1200px;
      margin: auto;
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: 30px;
    }

    footer h3 {
      color: #ffdf59;
      margin-bottom: 13px;
    }

    footer ul {
      list-style: none;
    }

    footer li {
      margin-bottom: 8px;
    }

    footer a:hover {
      color: #ffdf59;
    }

    .copyright {
      max-width: 1200px;
      margin: 30px auto 0;
      padding-top: 16px;
      border-top: 1px solid #ffffff35;
      text-align: center;
      font-size: 14px;
    }

    @media (max-width: 700px) {
      .navbar {
        flex-direction: column;
        gap: 8px;
      }

      .nav-links {
        justify-content: center;
        gap: 12px;
        font-size: 14px;
      }

      .hero {
        min-height: 420px;
      }

      .profiles,
      .footer-grid {
        grid-template-columns: 1fr;
      }

      .stats-grid {
        grid-template-columns: 1fr;
        gap: 22px;
      }

      .stat-number {
        font-size: 34px;
      }

      .section {
        padding-top: 45px;
        padding-bottom: 45px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        scroll-behavior: auto !important;
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>

